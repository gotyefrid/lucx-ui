@@ -39,6 +39,18 @@ func trackCredentialConnection(password, deviceID string, conn net.Conn) func()
 	}
 }
 
+// credentialActiveDevices считает устройства с живыми подключениями этого пароля.
+// Глобальный activeDevices для этого не годится: старые клиенты делят "unknown".
+func credentialActiveDevices(password string) int {
+	credentialConnections.Lock()
+	defer credentialConnections.Unlock()
+	devices := make(map[string]struct{})
+	for _, deviceID := range credentialConnections.items[wrapKeyID(password)] {
+		devices[deviceID] = struct{}{}
+	}
+	return len(devices)
+}
+
 func disconnectCredentialConnections(password string) {
 	disconnectCredentialDeviceConnections(password, "")
 }
