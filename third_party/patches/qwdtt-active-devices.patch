new file mode 100644
index 0000000..c78e5eb
--- /dev/null
+++ b/server/active_devices_test.go
@@ -0,0 +1,40 @@
+package main
+
+import (
+	"net"
+	"testing"
+)
+
+// Старые клиенты без device_id приходят как "unknown"; несколько паролей делят
+// эту запись, и подключение одного не должно делать онлайн остальные.
+func TestAdminActiveDevicesCountsOnlyOwnConnections(t *testing.T) {
+	shared := []string{"unknown"}
+	router := &PasswordEntry{Label: "router", DeviceIDs: shared}
+	laptop := &PasswordEntry{Label: "laptop", DeviceIDs: shared}
+
+	conn, peer := net.Pipe()
+	defer conn.Close()
+	defer peer.Close()
+
+	untrack := trackCredentialConnection("router-pass", "unknown", conn)
+	activeDevicesMu.Lock()
+	activeDevices["unknown"]++
+	activeDevicesMu.Unlock()
+	defer func() {
+		activeDevicesMu.Lock()
+		delete(activeDevices, "unknown")
+		activeDevicesMu.Unlock()
+	}()
+
+	if got := toAdminPasswordView("router-pass", router).ActiveDevices; got != 1 {
+		t.Fatalf("router active_devices = %d, want 1", got)
+	}
+	if got := toAdminPasswordView("laptop-pass", laptop).ActiveDevices; got != 0 {
+		t.Fatalf("laptop active_devices = %d, want 0 (its only device is in use by another password)", got)
+	}
+
+	untrack()
+	if got := toAdminPasswordView("router-pass", router).ActiveDevices; got != 0 {
+		t.Fatalf("router active_devices after disconnect = %d, want 0", got)
+	}
+}
