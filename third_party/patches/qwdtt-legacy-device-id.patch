diff --git a/server/legacy_device_test.go b/server/legacy_device_test.go
new file mode 100644
index 0000000..4b23e69
--- /dev/null
+++ b/server/legacy_device_test.go
@@ -0,0 +1,45 @@
+package main
+
+import "testing"
+
+// Пароли старых клиентов, привязанные к общему "unknown", после загрузки базы
+// должны пускать свой клиент и получать отдельные устройства.
+func TestLegacyUnknownBindingsBecomePerPassword(t *testing.T) {
+	saved := db
+	defer func() { db = saved }()
+	db = &Database{
+		Passwords: map[string]*PasswordEntry{
+			"router-pass": {DeviceID: "unknown", DeviceIDs: []string{"unknown"}},
+			"laptop-pass": {DeviceID: "unknown"},
+			"phone-pass":  {DeviceID: "phone-1", DeviceIDs: []string{"phone-1"}},
+		},
+		Devices: map[string]*ClientDevice{
+			"unknown": {DeviceID: "unknown", IP: "10.68.66.2"},
+			"phone-1": {DeviceID: "phone-1", IP: "10.68.66.3"},
+		},
+	}
+
+	migrateLegacyUnknownDevicesLocked()
+
+	if _, ok := db.Devices["unknown"]; ok {
+		t.Fatal(`shared "unknown" device survived the migration`)
+	}
+	if _, ok := db.Devices["phone-1"]; !ok {
+		t.Fatal("a real device was dropped by the migration")
+	}
+	router := clientDeviceID("unknown", "router-pass")
+	laptop := clientDeviceID("", "laptop-pass")
+	if router == laptop {
+		t.Fatalf("two passwords without a device id share %q", router)
+	}
+	// MaxDevices 0 = одно устройство: без переписанной привязки будет device_mismatch.
+	if !db.Passwords["router-pass"].canConnectAndBind(router) {
+		t.Fatal("router password refuses its own legacy client after migration")
+	}
+	if !db.Passwords["laptop-pass"].canConnectAndBind(laptop) {
+		t.Fatal("laptop password refuses its own legacy client after migration")
+	}
+	if got := clientDeviceID("phone-1", "phone-pass"); got != "phone-1" {
+		t.Fatalf("real device id rewritten to %q", got)
+	}
+}
