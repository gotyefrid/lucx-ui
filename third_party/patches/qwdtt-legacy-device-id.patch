+// clientDeviceID даёт клиенту без device_id устройство своего пароля: иначе все
+// такие клиенты делят одну запись "unknown" (общий ключ и адрес WireGuard).
+func clientDeviceID(deviceID, password string) string {
+	if deviceID == "" || deviceID == "unknown" {
+		return "legacy-" + wrapKeyID(password)
+	}
+	return deviceID
+}
+
+// migrateLegacyUnknownDevicesLocked переписывает старые привязки "unknown" на
+// устройство пароля, чтобы пароль с лимитом в одно устройство не отказал клиенту.
+func migrateLegacyUnknownDevicesLocked() {
+	for password, entry := range db.Passwords {
+		if entry == nil {
+			continue
+		}
+		legacy := clientDeviceID("", password)
+		if entry.DeviceID == "unknown" {
+			entry.DeviceID = legacy
+		}
+		for i, id := range entry.DeviceIDs {
+			if id == "unknown" {
+				entry.DeviceIDs[i] = legacy
+			}
+		}
+	}
+	delete(db.Devices, "unknown")
+}
