+++ b/server/subnets_test.go
@@ -0,0 +1,108 @@
+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestParseClientSubnet(t *testing.T) {
+	cases := []struct {
+		in, server, serverCIDR, err string
+	}{
+		{in: "10.68.0.0/16", server: "10.68.66.1", serverCIDR: "10.68.66.1/16"},
+		{in: "10.70.0.0/16", server: "10.70.66.1", serverCIDR: "10.70.66.1/16"},
+		{in: "192.168.0.0/17", server: "192.168.66.1", serverCIDR: "192.168.66.1/17"},
+		{in: "192.168.77.0/24", server: "192.168.77.254", serverCIDR: "192.168.77.254/24"},
+		{in: " 172.20.0.0/20 ", server: "172.20.15.254", serverCIDR: "172.20.15.254/20"},
+		{in: "10.68.1.0/16", err: "не адрес сети"},
+		{in: "10.68.0.0", err: "CIDR"},
+		{in: "fd00::/64", err: "IPv4"},
+		{in: "10.0.0.0/31", err: "/8../30"},
+	}
+	for _, tc := range cases {
+		t.Run(tc.in, func(t *testing.T) {
+			s, err := parseClientSubnet(tc.in)
+			if tc.err != "" {
+				if err == nil || !strings.Contains(err.Error(), tc.err) {
+					t.Fatalf("err = %v, want containing %q", err, tc.err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := s.server.String(); got != tc.server {
+				t.Fatalf("server = %s, want %s", got, tc.server)
+			}
+			if got := s.serverCIDR(); got != tc.serverCIDR {
+				t.Fatalf("serverCIDR = %s, want %s", got, tc.serverCIDR)
+			}
+		})
+	}
+}
+
+func TestConfigureSubnetsRejectsOverlap(t *testing.T) {
+	err := configureSubnets("10.68.0.0/16", "10.68.5.0/24")
+	if err == nil || !strings.Contains(err.Error(), "пересекаются") {
+		t.Fatalf("err = %v, want overlap error", err)
+	}
+}
+
+func TestNextFreeSkipsServerAndUsed(t *testing.T) {
+	s, err := parseClientSubnet("10.9.9.0/30")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := s.nextFree(map[string]bool{}); got != "10.9.9.1" {
+		t.Fatalf("first = %q, want 10.9.9.1", got)
+	}
+	if got := s.nextFree(map[string]bool{"10.9.9.1": true}); got != "" {
+		t.Fatalf("exhausted /30 (only server left) = %q, want empty", got)
+	}
+}
+
+// Upstream skipped 10.66.66.1 mid-pool; allocation must step over the
+// server address, not stop there and report the /16 exhausted.
+func TestNextFreeStepsOverMidPoolServer(t *testing.T) {
+	s, err := parseClientSubnet("10.68.0.0/16")
+	if err != nil {
+		t.Fatal(err)
+	}
+	used := map[string]bool{}
+	for a := s.prefix.Addr().Next(); a != s.server; a = a.Next() {
+		used[a.String()] = true
+	}
+	if got := s.nextFree(used); got != "10.68.66.2" {
+		t.Fatalf("next after server = %q, want 10.68.66.2", got)
+	}
+}
+
+func TestReassignForeignDeviceIPs(t *testing.T) {
+	if err := configureSubnets("10.80.0.0/24", "10.81.0.0/24"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = configureSubnets(defaultWGSubnet, defaultRawSubnet) })
+	db = &Database{Devices: map[string]*ClientDevice{
+		"kept":     {DeviceID: "kept", IP: "10.80.0.1", RawIP: "10.81.0.1"},
+		"old-wg":   {DeviceID: "old-wg", IP: "10.68.0.7", RawIP: "10.70.0.7"},
+		"on-srv":   {DeviceID: "on-srv", IP: "10.80.0.254"},
+		"raw-only": {DeviceID: "raw-only", RawIP: "10.81.0.2"},
+	}}
+
+	if changed := reassignForeignIPsLocked(); changed != 2 {
+		t.Fatalf("changed = %d, want 2", changed)
+	}
+	d := db.Devices
+	if d["kept"].IP != "10.80.0.1" || d["kept"].RawIP != "10.81.0.1" {
+		t.Fatalf("in-subnet device moved: %+v", d["kept"])
+	}
+	if d["raw-only"].IP != "" || d["raw-only"].RawIP != "10.81.0.2" {
+		t.Fatalf("raw-only device touched: %+v", d["raw-only"])
+	}
+	if d["old-wg"].IP != "10.80.0.2" || d["old-wg"].RawIP != "" {
+		t.Fatalf("old-wg = %+v, want IP 10.80.0.2 and RawIP cleared for re-issue", d["old-wg"])
+	}
+	if d["on-srv"].IP != "10.80.0.3" {
+		t.Fatalf("device on server address = %+v, want IP 10.80.0.3", d["on-srv"])
+	}
+}
