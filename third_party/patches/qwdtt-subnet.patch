diff --git a/server/subnets.go b/server/subnets.go
new file mode 100644
index 0000000..e73b92c
--- /dev/null
+++ b/server/subnets.go
@@ -0,0 +1,140 @@
+package main
+
+import (
+	"fmt"
+	"net/netip"
+	"sort"
+	"strings"
+)
+
+// Подсети клиентов задаются флагами -wg-subnet / -raw-subnet (LucX).
+// Сервер, как в upstream, на <сеть>.66.1; если его нет в сети — последний хост.
+const (
+	defaultWGSubnet  = "10.68.0.0/16"
+	defaultRawSubnet = "10.70.0.0/16"
+)
+
+type clientSubnet struct {
+	prefix netip.Prefix
+	server netip.Addr
+}
+
+var (
+	wgNet, rawNet clientSubnet
+
+	wgServerAddr, wgServerCIDR   string
+	rawServerAddr, rawServerCIDR string
+)
+
+func init() {
+	if err := configureSubnets(defaultWGSubnet, defaultRawSubnet); err != nil {
+		panic(err)
+	}
+}
+
+func parseClientSubnet(cidr string) (clientSubnet, error) {
+	cidr = strings.TrimSpace(cidr)
+	p, err := netip.ParsePrefix(cidr)
+	if err != nil {
+		return clientSubnet{}, fmt.Errorf("подсеть %q: ожидается CIDR вида 10.68.0.0/16", cidr)
+	}
+	if !p.Addr().Is4() {
+		return clientSubnet{}, fmt.Errorf("подсеть %q: нужна IPv4", cidr)
+	}
+	if p.Bits() < 8 || p.Bits() > 30 {
+		return clientSubnet{}, fmt.Errorf("подсеть %q: длина префикса должна быть /8../30", cidr)
+	}
+	if p.Masked() != p {
+		return clientSubnet{}, fmt.Errorf("подсеть %q: не адрес сети, нужно %s", cidr, p.Masked())
+	}
+	b := p.Addr().As4()
+	network := uint32(b[0])<<24 | uint32(b[1])<<16 | uint32(b[2])<<8 | uint32(b[3])
+	broadcast := network | ^uint32(0)>>p.Bits()
+	server := network + 66<<8 + 1
+	if server >= broadcast {
+		server = broadcast - 1
+	}
+	return clientSubnet{prefix: p, server: addrFromUint32(server)}, nil
+}
+
+func addrFromUint32(v uint32) netip.Addr {
+	return netip.AddrFrom4([4]byte{byte(v >> 24), byte(v >> 16), byte(v >> 8), byte(v)})
+}
+
+func configureSubnets(wg, raw string) error {
+	w, err := parseClientSubnet(wg)
+	if err != nil {
+		return fmt.Errorf("-wg-subnet: %w", err)
+	}
+	r, err := parseClientSubnet(raw)
+	if err != nil {
+		return fmt.Errorf("-raw-subnet: %w", err)
+	}
+	if w.prefix.Overlaps(r.prefix) {
+		return fmt.Errorf("подсети WG %s и Raw %s пересекаются", w.prefix, r.prefix)
+	}
+	wgNet, rawNet = w, r
+	wgServerAddr, wgServerCIDR = w.server.String(), w.serverCIDR()
+	rawServerAddr, rawServerCIDR = r.server.String(), r.serverCIDR()
+	return nil
+}
+
+func (s clientSubnet) serverCIDR() string {
+	return netip.PrefixFrom(s.server, s.prefix.Bits()).String()
+}
+
+// owns сообщает, может ли клиент держать этот адрес в текущей подсети.
+func (s clientSubnet) owns(ip string) bool {
+	a, err := netip.ParseAddr(ip)
+	return err == nil && s.prefix.Contains(a) && a != s.server
+}
+
+func (s clientSubnet) nextFree(used map[string]bool) string {
+	for a := s.prefix.Addr().Next(); s.prefix.Contains(a.Next()); a = a.Next() {
+		if ip := a.String(); a != s.server && !used[ip] {
+			return ip
+		}
+	}
+	return ""
+}
+
+// reassignForeignIPsLocked переносит устройства, чьи адреса остались от
+// прежней подсети. RawIP обнуляется: raw-путь выдаёт его заново при GETCONF.
+func reassignForeignIPsLocked() int {
+	ids := make([]string, 0, len(db.Devices))
+	for id := range db.Devices {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+
+	used := make(map[string]bool)
+	var moveWG []*ClientDevice
+	changed := 0
+	for _, id := range ids {
+		dev := db.Devices[id]
+		if dev == nil {
+			continue
+		}
+		moved := false
+		if dev.IP != "" {
+			if wgNet.owns(dev.IP) {
+				used[dev.IP] = true
+			} else {
+				moveWG = append(moveWG, dev)
+				moved = true
+			}
+		}
+		if dev.RawIP != "" && !rawNet.owns(dev.RawIP) {
+			dev.RawIP = ""
+			moved = true
+		}
+		if moved {
+			changed++
+		}
+	}
+	for _, dev := range moveWG {
+		dev.IP = wgNet.nextFree(used)
+		used[dev.IP] = true
+	}
+	return changed
+}
diff --git a/server/subnets_test.go b/server/subnets_test.go
new file mode 100644
index 0000000..35de3c6
